# systemd USER service (not a system service) - deliberately, because live
# audio on Linux goes through the logged-in user's PulseAudio/PipeWire
# session. A system-level service runs with no access to that session unless
# you fight XDG_RUNTIME_DIR/D-Bus routing for no real benefit here.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp dhwanik.service ~/.config/systemd/user/
#   # edit the two %h paths below if this repo is not at ~/SIH-2026-main
#   cp dhwanik.env.example ~/SIH-2026-main/dhwanik.env   # optional, see below
#   systemctl --user daemon-reload
#   systemctl --user enable --now dhwanik.service
#   journalctl --user -u dhwanik -f                      # watch it run
#
# Runs without an active login (e.g. after a reboot with no one logged in):
#   loginctl enable-linger $USER

[Unit]
Description=Dhwanik live speech enhancement (mic -> model -> speaker)
After=sound.target pulseaudio.service pipewire.service

[Service]
Type=simple
WorkingDirectory=%h/SIH-2026-main
ExecStart=%h/SIH-2026-main/scripts/run_service.sh
EnvironmentFile=-%h/SIH-2026-main/dhwanik.env
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
