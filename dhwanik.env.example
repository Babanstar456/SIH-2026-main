# Copy to dhwanik.env (NOT committed - see .gitignore) and adjust for this
# machine, then `systemctl --user restart dhwanik`. Run `python main.py --list`
# to find your device indices first; a wrong index fails loudly with a clear
# error rather than silently picking the wrong device.

# DHWANIK_IN_DEVICE=1
# DHWANIK_OUT_DEVICE=4
# DHWANIK_ONNX=artifacts/model_lowsnr_simple.onnx
# DHWANIK_FLOOR_DB=-18
